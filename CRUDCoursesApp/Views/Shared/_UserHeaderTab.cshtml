<thead class="bg-slate-100 border-b border-slate-200">
    <tr>
        <!-- Name -->
        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
            @if (ViewBag.CurrentSortBy == nameof(UserResponse.Name) && ViewBag.CurrentSortOrder == SortOption.ASC.ToString())
            {
                <a href="/admin/users/view?searchBy=@(ViewBag.CurrentSearchBy)&searchString=@(ViewBag.CurrentSearchString)&sortBy=@(nameof(UserResponse.Name))&sortOption=DESC" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-800 transition-colors duration-150">
                    User Name <i class="fa-solid fa-chevron-up text-xs"></i>
                </a>
            }
            else if (ViewBag.CurrentSortBy == nameof(UserResponse.Name) && ViewBag.CurrentSortOrder == SortOption.DESC.ToString())
            {
                <a href="/admin/users/view?searchBy=@(ViewBag.CurrentSearchBy)&searchString=@(ViewBag.CurrentSearchString)&sortBy=@(nameof(UserResponse.Name))&sortOption=ASC" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-800 transition-colors duration-150">
                    User Name <i class="fa-solid fa-chevron-down text-xs"></i>
                </a>
            }
            else
            {
