<!-- Quick stats display inside the admin pannel -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

    <!-- Total of registered users -->
    <div class="bg-white p-5 rounded-xl border border-gray-200/80 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total of registered users</p>
                <h4 class="text-2xl font-bold text-gray-900 mt-1">@ViewBag.TotalUserCounts</h4>
            </div>
            <span class="p-2 bg-blue-50 text-blue-600 rounded-lg"><i class="fa-solid fa-user"></i></span>
        </div>
    </div>

    <!-- Total of communities -->
    <div class="bg-white p-5 rounded-xl border border-gray-200/80 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total of communities</p>
                <h4 class="text-2xl font-bold text-gray-900 mt-1">@ViewBag.TotalComunitiesCounts</h4>
            </div>
            <span class="p-2 bg-emerald-50 text-emerald-600 rounded-lg"><i class="fa-solid fa-book"></i></span>
        </div>
    </div>

    <!-- Total of posts -->
    <div class="bg-white p-5 rounded-xl border border-gray-200/80 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total of posts</p>
                <h4 class="text-2xl font-bold text-gray-900 mt-1">@ViewBag.TotalPostsCounts</h4>
            </div>
            <span class="p-2 bg-purple-50 text-purple-600 rounded-lg"><i class="fa-solid fa-user-graduate"></i></span>
        </div>
    </div>

    <!-- Total of likes -->
    <div class="bg-white p-5 rounded-xl border border-gray-200/80 shadow-sm">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total of likes</p>
                <h4 class="text-2xl font-bold text-gray-900 mt-1">@ViewBag.TotalLikesCounts</h4>
            </div>
            <span class="p-2 bg-amber-50 text-blue-600 rounded-lg"><i class="fa-solid fa-thumbs-up"></i></span>
        </div>
    </div>

</div>