@{
    ViewData["Title"] = "Créer un compte - Proxiio";
}

<main class="static-page static-auth-page">
    <section class="static-auth-card">
        <a class="static-auth-brand" href="/home"><span>p</span> proxiio</a>
        <span class="static-eyebrow">Bienvenue dans la communauté</span>
        <h1>Créez votre espace.</h1>
        <p class="static-auth-lead">Un compte vous permettra de rejoindre les conversations et de partager vos idées.</p>
        <div class="static-notice"><i class="fa-solid fa-circle-info"></i><p>La création de compte en libre-service n’est pas encore activée. Pour demander un accès, contactez l’administrateur de votre plateforme.</p></div>
        <a class="static-button static-button-primary static-button-wide" href="/contact">Demander un accès <i class="fa-solid fa-arrow-right"></i></a>
        <p class="static-auth-switch">Vous avez déjà accès ? <a href="/authenticate">Voir les options de connexion</a></p>
    </section>
    <aside class="static-auth-aside"><div class="static-auth-aside-mark"><i class="fa-solid fa-people-group"></i></div><span class="static-eyebrow">Proxiio, ensemble</span><h2>Les meilleures idées naissent quand on les partage.</h2><p>Retrouvez des communautés et des conversations qui vous inspirent.</p><div class="static-auth-aside-dots"><i></i><i></i><i></i></div></aside>
</main>
