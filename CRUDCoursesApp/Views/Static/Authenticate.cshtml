@{
    ViewData["Title"] = "Connexion - Proxiio";
}

<main class="static-page static-auth-page">
    <section class="static-auth-card">
        <a class="static-auth-brand" href="/home"><span>p</span> proxiio</a>
        <span class="static-eyebrow">Heureux de vous revoir</span>
        <h1>Retrouvez votre communauté.</h1>
        <p class="static-auth-lead">Connectez-vous à l’espace Proxiio de votre organisation pour reprendre vos échanges.</p>
        <div class="static-notice"><i class="fa-solid fa-circle-info"></i><p>La connexion des membres n’est pas encore configurée sur cette version. Si vous avez déjà un compte, demandez à l’administrateur de votre plateforme comment y accéder.</p></div>
        <a class="static-button static-button-primary static-button-wide" href="/contact">Contacter l’administrateur <i class="fa-solid fa-arrow-right"></i></a>
        <p class="static-auth-switch">Pas encore de compte ? <a href="/register">Demander un accès</a></p>
    </section>
    <aside class="static-auth-aside"><div class="static-auth-aside-mark"><i class="fa-solid fa-comments"></i></div><span class="static-eyebrow">Reprenez le fil</span><h2>Vos échanges vous attendent.</h2><p>Des idées nouvelles, des conseils utiles et des personnes à retrouver.</p><div class="static-auth-aside-dots"><i></i><i></i><i></i></div></aside>
</main>
