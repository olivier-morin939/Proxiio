@{
    ViewData["Title"] = "Accueil - Proxiio";
}

<main class="static-page">
    <section class="static-hero">
        <div class="static-hero-copy">
            <span class="static-eyebrow"><i class="fa-solid fa-sparkles"></i> Votre espace de communautés</span>
            <h1>Les bonnes idées grandissent <span>ensemble.</span></h1>
            <p>Rejoignez des communautés qui vous ressemblent, échangez des idées et partagez ce qui vous passionne.</p>
            <div class="static-actions">
                <a class="static-button static-button-primary" href="/register">Découvrir Proxiio <i class="fa-solid fa-arrow-right"></i></a>
                <a class="static-button static-button-quiet" href="/services">Voir comment ça marche</a>
            </div>
            <div class="static-proof"><span class="static-proof-icons"><i class="fa-solid fa-user"></i><i class="fa-solid fa-user"></i><i class="fa-solid fa-user"></i></span><span>Un espace pour apprendre, partager et grandir.</span></div>
        </div>
        <div class="static-hero-art" aria-hidden="true">
            <div class="static-orbit static-orbit-one"></div><div class="static-orbit static-orbit-two"></div>
            <div class="static-art-bubble bubble-top"><i class="fa-solid fa-lightbulb"></i></div>
            <div class="static-art-bubble bubble-left"><i class="fa-solid fa-comments"></i></div>
            <div class="static-art-bubble bubble-right"><i class="fa-solid fa-seedling"></i></div>
            <div class="static-art-center"><span>p</span><b>Les idées<br />en commun</b></div>
            <span class="static-art-spark spark-one">✦</span><span class="static-art-spark spark-two">✧</span>
        </div>
    </section>

    <section class="static-section">
        <div class="static-section-heading"><span class="static-eyebrow">Simple et vivant</span><h2>Un endroit pour trouver votre monde.</h2><p>Des conversations utiles, des personnes curieuses et des communautés à rejoindre à votre rythme.</p></div>
        <div class="static-feature-grid">
            <article class="static-feature-card"><span class="static-feature-icon icon-violet"><i class="fa-solid fa-people-group"></i></span><h3>Des communautés qui rassemblent</h3><p>Explorez des groupes autour de vos intérêts et retrouvez facilement les personnes qui les font vivre.</p></article>
            <article class="static-feature-card"><span class="static-feature-icon icon-mint"><i class="fa-solid fa-pen-to-square"></i></span><h3>Des échanges qui font avancer</h3><p>Publiez une idée, posez une question et participez à des discussions ouvertes et constructives.</p></article>
            <article class="static-feature-card"><span class="static-feature-icon icon-amber"><i class="fa-solid fa-heart"></i></span><h3>Une place pour chacun</h3><p>Apprenez des autres, partagez votre expérience et contribuez à votre façon.</p></article>
        </div>
    </section>

    <section class="static-cta"><div><span class="static-eyebrow">On commence ?</span><h2>Votre prochaine conversation est ici.</h2></div><a class="static-button static-button-light" href="/register">Explorer Proxiio <i class="fa-solid fa-arrow-right"></i></a></section>
</main>
