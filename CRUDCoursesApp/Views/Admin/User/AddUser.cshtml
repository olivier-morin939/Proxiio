@model AddUserRequest
@{
    ViewData["Title"] = "Admin - Add User";
}

@* Styling files needed for this page *@
@section HeadContent
{
    <link rel="stylesheet" href="~/css/Forms.css" />
}

<div class="app-form-container">
    <!-- Header -->
    <div class="app-form-header">
        <div>
            <h1 class="app-form-title">Add New User</h1>
            <p class="app-form-subtitle">Create a new user account in the system.</p>
        </div>
        <a asp-controller="Admin" asp-action="DisplayUsers" class="app-btn app-btn-secondary">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            Back to List
        </a>
    </div>

    <!-- Flash Messages -->
    <div asp-validation-summary="All"></div>

    <!-- Add Form Card -->
    <div class="app-form-card">
        <form asp-controller="Admin" asp-action="AddUser" method="POST" class="app-form-body">

            <!-- Grid Fields -->
            <div class="app-form-grid">

                <!-- Full Name -->
                <div class="app-form-group">
                    <label asp-for="Name" class="app-form-label">Full Name</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-user text-sm"></i>
                        </div>
                        <input asp-for="Name" placeholder="John Doe" class="app-form-input" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="app-form-group">
                    <label asp-for="Email" class="app-form-label">Email Address</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-envelope text-sm"></i>
                        </div>
                        <input asp-for="Email" placeholder="user@example.com" class="app-form-input" />
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>

                <!-- Password -->
                <div class="app-form-group">
                    <label asp-for="Password" class="app-form-label">Password</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </div>
                        <input asp-for="Password" placeholder="••••••••" class="app-form-input" />
                        <span asp-validation-for="Password"></span>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="app-form-group">
                    <label asp-for="ConfirmPassword" class="app-form-label">Confirm Password</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-shield-halved text-sm"></i>
                        </div>
                        <input asp-for="ConfirmPassword" placeholder="••••••••" class="app-form-input" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>

                <!-- Role Selection -->
                <div class="app-form-group">
                    <label asp-for="Role" class="app-form-label">User Role</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-user-shield text-sm"></i>
                        </div>
                        <select asp-for="Role" class="app-form-select">
                            <option value="@Role.User" selected="@(Model?.Role == Role.User ? "selected" : null)">@Role.User.ToString()</option>
                            <option value="@Role.Moderator" selected="@(Model?.Role == Role.Moderator ? "selected" : null)">@Role.Moderator.ToString()</option>
                            <option value="@Role.Administrator" selected="@(Model?.Role == Role.Administrator ? "selected" : null)">@Role.Administrator.ToString()</option>
                        </select>
                        <span asp-validation-for="Role"></span>
                    </div>
                </div>

                <!-- UserState Selection -->
                <div class="app-form-group">
                    <label asp-for="UserState" class="app-form-label">User State</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-user-shield text-sm"></i>
                        </div>
                        <select asp-for="UserState" class="app-form-select">
                            <option value="@UserState.Active" selected="@(Model?.UserState == UserState.Active ? "selected" : null)">@UserState.Active.ToString()</option>
                            <option value="@UserState.Inactive" selected="@(Model?.UserState == UserState.Inactive ? "selected" : null)">@UserState.Inactive.ToString()</option>
                            <option value="@UserState.Banned" selected="@(Model?.UserState == UserState.Banned ? "selected" : null)">@UserState.Banned.ToString()</option>
                        </select>
                        <span asp-validation-for="UserState"></span>
                    </div>
                </div>

                <!-- Date of Birth -->
                <div class="app-form-group">
                    <label asp-for="DateOfBirth" class="app-form-label">Date of Birth</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon">
                            <i class="fa-solid fa-calendar text-sm"></i>
                        </div>
                        <input asp-for="DateOfBirth" class="app-form-input" />
                        <span asp-validation-for="DateOfBirth"></span>
                    </div>
                </div>

            </div>

            <!-- Newsletter Checkbox Card -->
            <div class="app-form-option-card">
                <label class="app-form-checkbox-label">
                    <input type="checkbox" for="ReceiveNewsLetter" value="false" class="app-form-checkbox" />
                    <span class="app-form-option-text">
                        <span class="app-form-option-title">Subscribe to Newsletter</span>
                        <span class="app-form-option-desc">Receive marketing updates and periodic user bulletins.</span>
                    </span>
                </label>
            </div>

            <!-- Action Buttons -->
            <div class="app-form-actions">
                <button type="reset" class="app-btn app-btn-secondary">
                    <i class="fa-solid fa-rotate-left text-xs"></i>
                    Reset
                </button>
                <button type="submit" class="app-btn app-btn-primary">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                    Create User
                </button>
            </div>

        </form>
    </div>
</div>

@* Scripting files needed for this page *@
@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" 
            asp-fallback-src="~/Scripts/jquery.min.js" 
            asp-fallback-test="window.jQuery"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js" 
            asp-fallback-src="~/Scripts/jquery.validate.min.js" 
            asp-fallback-test="window.jQuery && window.jQuery.validator"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" 
            asp-fallback-src="~/Scripts/jquery.validate.unobtrusive.min.js" 
            asp-fallback-test="window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive"></script>
}   