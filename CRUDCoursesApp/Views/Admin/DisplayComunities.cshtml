@model IEnumerable<ComunityResponse>
@{
    ViewData["Title"] = "Admin Dashboard - Proxiio";
}

@section HeadContent
{
    <link rel="stylesheet" href="~/css/Tabs.css" />
}

<div class="app-tabs-container">
    <!-- Header Page -->
    <div class="app-tabs-header">
        <div>
            <h1 class="app-tabs-title">Communities</h1>
            <p class="app-tabs-subtitle">Manage and filter your system communities.</p>
        </div>
        <div class="admin-header-actions">
            <!-- Bouton Ajouter une Communauté -->
            <a href="/admin/comunities/add" class="app-tab-btn app-tab-btn-primary">
                <i class="fa-solid fa-plus text-xs"></i>
                Add Community
            </a>
            <!-- Bouton Export PDF -->
            <a asp-controller="Admin" asp-action="ExportToPDF" asp-route-ModelToExport="ComunityResponse" class="app-tab-btn app-tab-btn-secondary">
                <i class="fa-solid fa-file-pdf"></i>
                Export communities in PDF
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    @{
        await Html.RenderPartialAsync("_FlashMessagesComponent");
    }

    <!-- Filter & Search Bar -->
    <div class="app-tabs-filter-card">
        <form action="/admin/comunities/view" method="get" class="app-tabs-filter-form">

            <!-- Select Field -->
            <div class="app-tabs-select-wrapper">
                <select name="searchBy" class="app-tabs-select">
                    @if (ViewBag.SearchFields != null)
                    {
                        foreach (var field in ViewBag.SearchFields)
                        {
                            <option value="@field.Key" selected="@(ViewBag.CurrentSearchBy == field.Key ? "selected" : null)">
                                @field.Value
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- Search Input -->
            <div class="app-tabs-search-wrapper">
                <div class="app-tabs-search-icon">
                    <i class="fa-solid fa-magnifying-glass text-sm"></i>
                </div>
                <input type="search" name="searchString" placeholder="Search communities..." value="@ViewBag.CurrentSearchString" class="app-tabs-search-input" />
            </div>

            <!-- Action Buttons -->
            <div class="app-tabs-actions-wrapper">
                <button type="submit" class="app-tab-btn app-tab-btn-primary" style="width: 100%;">
                    <i class="fa-solid fa-filter text-xs"></i>
                    Search
                </button>

                <a href="/admin/comunities/view" class="app-tab-btn app-tab-btn-icon" title="Reset Filters">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Data Table Container / Empty State -->
    @if (Model != null && Model.Any())
    {
        <div class="app-tabs-table-card">
            <div class="app-tabs-table-responsive">
                <table class="app-tabs-table">

                    @{
                        await Html.RenderPartialAsync("_ComunityHeaderTab", viewData: ViewData);
                    }

                    <tbody class="app-tabs-tbody">
                        @foreach (ComunityResponse comResponse in Model)
                        {
                            <tr class="app-tabs-tr">
                                <!-- Community Name -->
                                <td class="app-tabs-td">
                                    <span class="app-tabs-user-name">@comResponse.Name</span>
                                </td>

                                <!-- Community Description -->
                                <td class="app-tabs-td app-tabs-text-muted">
                                    @comResponse.Description
                                </td>

                                <!-- Owner Id -->
                                <td class="app-tabs-td">
                                    <span class="app-tab-badge app-tab-badge-role">
                                        @comResponse.TeacherId.ToString()
                                    </span>
                                </td>

                                <!-- Users Count -->
                                <td class="app-tabs-td">
                                    <span class="app-tab-badge app-tab-badge-count">
                                        <i class="fa-solid fa-users text-xs"></i> @comResponse.UsersCount
                                    </span>
                                </td>

                                <!-- Posts Count -->
                                <td class="app-tabs-td">
                                    <span class="app-tab-badge app-tab-badge-count">
                                        <i class="fa-solid fa-file-lines text-xs"></i> @comResponse.PostsCount
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="app-tabs-td" style="text-align: right;">
                                    <div class="app-tab-actions-cell">
                                        <a href="/admin/comunities/view/@comResponse.Id"
                                           class="app-tab-action-btn app-tab-action-details">
                                            Details
                                        </a>
                                        <a href="/admin/comunities/update/@comResponse.Id"
                                           class="app-tab-action-btn app-tab-action-update">
                                            Update
                                        </a>
                                        <a href="/admin/comunities/delete/@comResponse.Id"
                                           class="app-tab-action-btn app-tab-action-delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State Component -->
        <div class="app-tabs-empty-card">
            <div class="app-tabs-empty-icon-wrapper">
                <i class="fa-solid fa-users-slash text-xl"></i>
            </div>
            <h3 class="app-tabs-empty-title">No communities found</h3>
            <p class="app-tabs-empty-desc">
                We couldn't find any communities matching your criteria. Try adjusting your search term or filter.
            </p>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearchString))
            {
                <a href="/admin/comunities/view" class="app-tab-btn app-tab-btn-icon" style="display: inline-flex;">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    Clear Search
                </a>
            }
        </div>
    }
</div>