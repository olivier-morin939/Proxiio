@model IEnumerable<UserResponse>
@{
    Layout = null;
}

@if (Model != null && Model.Any())
{
    <link href="@("http://" + Context.Request.Host.ToString() + "/css/Tabs.css")" rel="stylesheet"/>
    <link href="@("http://" + Context.Request.Host.ToString() + "/css/admin.css")" rel="stylesheet" />

    <div class="app-tabs-table-card">
        <div class="app-tabs-table-responsive">
            <table class="app-tabs-table">
                <thead class="app-tabs-thead">
                    <tr class="app-tabs-tr">
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>State</th>
                        <th>Date of Birth</th>
                        <th>Newsletter</th>
                    </tr>
                </thead>
                <tbody class="app-tabs-tbody">
                    @foreach (UserResponse userResponse in Model)
                    {
                        <tr class="app-tabs-tr">
                            <!-- Utilisateur (Nom) -->
                            <td class="app-tabs-td">
                                <span class="app-tabs-user-name">@userResponse.Name</span>
                            </td>

                            <!-- Email -->
                            <td class="app-tabs-td app-tabs-text-muted">
                                @userResponse.Email
                            </td>

                            <!-- Rôle -->
                            <td class="app-tabs-td">
                                <span class="app-tab-badge app-tab-badge-role">
                                    @userResponse.Role.ToString()
                                </span>
                            </td>

                            <!-- État -->
                            <td class="app-tabs-td">
                                @if (userResponse.UserState.ToString().ToLower() == "active")
                                {
                                    <span class="app-tab-badge app-tab-badge-active">
                                        <span class="app-tab-badge-dot app-tab-dot-emerald"></span>
                                        @userResponse.UserState.ToString()
                                    </span>
                                }
                                else
                                {
                                    <span class="app-tab-badge app-tab-badge-inactive">
                                        <span class="app-tab-badge-dot app-tab-dot-amber"></span>
                                        @userResponse.UserState.ToString()
                                    </span>
                                }
                            </td>

                            <!-- Date de naissance -->
                            <td class="app-tabs-td app-tabs-text-muted">
                                <span>@userResponse.DateOfBirth.ToString("dd MMM yyyy")</span>
                            </td>

                            <!-- Newsletter -->
                            <td class="app-tabs-td">
                                @if (userResponse.ReceiveNewsLetter)
                                {
                                    <span class="app-tab-badge app-tab-badge-newsletter">
                                        <span class="app-tab-badge-dot app-tab-dot-emerald"></span>
                                        Subscribed
                                    </span>
                                }
                                else
                                {
                                    <span class="app-tab-badge app-tab-badge-no-newsletter">
                                        <span class="app-tab-badge-dot app-tab-dot-slate"></span>
                                        Not Subscribed
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- Empty State Component -->
    <div class="app-tabs-empty-card">
        <div class="app-tabs-empty-icon-wrapper">
            <i class="fa-solid fa-users-slash text-xl"></i>
        </div>
        <h3 class="app-tabs-empty-title">No users found</h3>
        <p class="app-tabs-empty-desc">
            We couldn't find any users matching your criteria. Try adjusting your search term or filter.
        </p>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearchString))
        {
            <a href="/admin/users/view" class="app-tab-btn app-tab-btn-icon" style="display: inline-flex;">
                <i class="fa-solid fa-xmark text-xs"></i>
                Clear Search
            </a>
        }
    </div>
}