@model ServiceContracts.DTO.Users.AddUserRequest
@{
    ViewData["Title"] = "Ajouter un membre";
    var communityId = (Guid)ViewBag.ComId;
}

<div class="admin-form-page">
    <a asp-action="DisplayUserByComunity" asp-route-ComId="@communityId" class="admin-back-link">← Retour aux membres</a>

    <form asp-action="AddUserByComunity" asp-route-ComId="@communityId" method="post" class="admin-form-card">
        <span class="admin-kicker">GESTION DE COMMUNAUTÉ</span>
        <h1>Ajouter un membre</h1>
        <p>Crée un nouveau compte membre et ajoute-le à cet espace.</p>

        <div asp-validation-summary="All" class="admin-validation"></div>

        <div class="admin-form-grid">
            <label class="admin-field">
                Nom
                <input asp-for="Name" class="admin-input" maxlength="120" required />
            </label>

            <label class="admin-field">
                Courriel
                <input asp-for="Email" class="admin-input" type="email" required />
            </label>

            <label class="admin-field">
                Mot de passe
                <input asp-for="Password" class="admin-input" type="password" minlength="8" required />
            </label>

            <label class="admin-field">
                Confirmation
                <input asp-for="ConfirmPassword" class="admin-input" type="password" minlength="8" required />
            </label>

            <label class="admin-field">
                Rôle
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<Role>()" class="admin-select"></select>
            </label>

            <label class="admin-field">
                État
                <select asp-for="UserState" asp-items="Html.GetEnumSelectList<UserState>()" class="admin-select"></select>
            </label>

            <label class="admin-field">
                Date de naissance
                <input asp-for="DateOfBirth" class="admin-input" type="date" required />
            </label>

            <label class="admin-field admin-checkbox">
                <input asp-for="ReceiveNewsLetter" /> Abonné aux nouvelles
            </label>
        </div>

        <div class="admin-form-actions">
            <a asp-action="DisplayUserByComunity" asp-route-ComId="@communityId" class="admin-btn secondary">Annuler</a>
            <button class="admin-btn" type="submit">Ajouter au groupe <span>→</span></button>
        </div>
    </form>
</div>
