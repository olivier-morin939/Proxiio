@model ComunityResponse
@{
    ViewData["Title"] = "Admin - Update Community";
}

<div class="max-w-3xl mx-auto p-6 space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Update community</h1>
            <p class="text-sm text-slate-500 mt-1">Modify global properties of the community.</p>
        </div>
        <a asp-controller="Admin" asp-action="DisplayComunities" class="px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">Back to list</a>
    </div>

    @{ await Html.RenderPartialAsync("_FlashMessagesComponent"); }

@section HeadContent {
    <link rel="stylesheet" href="~/css/admin-comunities.css" />
}

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <form asp-controller="Admin" asp-action="UpdateSpecificComunity" asp-route-ComId="@Model.Id" method="post" class="space-y-4">
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-slate-600 uppercase">Name</label>
                <input asp-for="Name" class="w-full mt-1 p-2 border rounded-md" />
                <span asp-validation-for="Name" class="text-rose-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-semibold text-slate-600 uppercase">Description</label>
                <textarea asp-for="Description" class="w-full mt-1 p-2 border rounded-md" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-rose-600 text-sm"></span>
            </div>

            <div class="flex items-center gap-3 justify-end">
                <a asp-controller="Admin" asp-action="DisplaySpecificComunity" asp-route-ComId="@Model.Id" class="px-3 py-2 bg-slate-100 rounded-md">Cancel</a>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md">Save changes</button>
            </div>
        </form>
    </div>
</div>
