@model IEnumerable<ServiceContracts.DTO.Signals.SignalResponse>
@{ ViewData["Title"] = "Signaux techniques"; }
<div class="app-tabs-container">
    <div class="app-tabs-header"><div><span class="admin-kicker">SUIVI TECHNIQUE</span><h1 class="app-tabs-title">Signaux</h1><p class="app-tabs-subtitle">Bugs et problèmes signalés sur la plateforme.</p></div><div class="admin-header-actions"><a asp-action="Index" class="app-tab-btn app-tab-btn-secondary">← Tableau de bord</a><a asp-action="AddSignal" class="app-tab-btn app-tab-btn-primary"><i class="fa-solid fa-plus"></i> Nouveau signal</a></div></div>
    @await Html.PartialAsync("_FlashMessagesComponent")
    @if (Model.Any())
    {
        <div class="app-tabs-table-card"><div class="app-tabs-table-responsive"><table class="app-tabs-table"><thead><tr><th>Problème</th><th>Niveau</th><th>Statut</th><th>Confirmé</th><th>Action</th></tr></thead><tbody>
        @foreach (var signal in Model)
        {
            <tr><td><b class="app-tabs-user-name">@signal.ProblemName</b><div class="post-body-preview">@signal.ProblemDescription</div></td><td><span class="admin-severity @signal.Level.ToString().ToLowerInvariant()">@signal.Level</span></td><td><span class="admin-id-badge">@signal.Status</span></td><td>@(signal.IsConfirmed ? "Oui" : "Non")</td><td><div class="app-tab-actions-cell"><a asp-action="UpdateSignal" asp-route-id="@signal.Id" class="app-tab-action-btn app-tab-action-update">Modifier</a><form asp-action="DeleteSignal" asp-route-id="@signal.Id" method="post"><button type="submit" class="app-tab-action-btn app-tab-action-delete">Supprimer</button></form></div></td></tr>
        }
        </tbody></table></div></div>
    }
    else { <div class="app-tabs-empty-card"><span class="admin-empty-icon"><i class="fa-solid fa-bug"></i></span><h3 class="app-tabs-empty-title">Aucun signal technique</h3><p class="app-tabs-empty-desc">Les problèmes techniques signalés s’afficheront ici.</p></div> }
</div>
