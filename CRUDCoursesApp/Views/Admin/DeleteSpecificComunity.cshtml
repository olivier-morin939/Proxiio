@model ComunityResponse
@{
    ViewData["Title"] = "Admin - Delete Community";
}

<div class="max-w-3xl mx-auto p-6 space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Delete community</h1>
            <p class="text-sm text-slate-500 mt-1">Confirm deletion of this community (global only).</p>
        </div>
        <a asp-controller="Admin" asp-action="DisplayComunities" class="px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200">Back to list</a>
    </div>

    @{ await Html.RenderPartialAsync("_FlashMessagesComponent"); }

@section HeadContent {
    <link rel="stylesheet" href="~/css/admin-comunities.css" />
}

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="mb-4">
            <h3 class="text-sm font-semibold text-slate-500 uppercase">Name</h3>
            <p class="mt-1 text-lg font-medium text-slate-900">@Model.Name</p>
        </div>
        <div class="mb-4">
            <h3 class="text-sm font-semibold text-slate-500 uppercase">Description</h3>
            <p class="mt-1 text-sm text-slate-700">@Model.Description</p>
        </div>

        <div class="pt-4 border-t flex justify-end gap-3">
            <a asp-controller="Admin" asp-action="DisplayComunities" asp-route-ComId="@Model.Id" class="px-3 py-2 bg-slate-100 rounded-md">Cancel</a>
            <form asp-controller="Admin" asp-action="DeleteSpecificComunityConfirm" asp-route-ComId="@Model.Id" method="post">
                <button type="submit" class="px-4 py-2 bg-rose-600 text-white rounded-md">Delete community</button>
            </form>
        </div>
    </div>
</div>
