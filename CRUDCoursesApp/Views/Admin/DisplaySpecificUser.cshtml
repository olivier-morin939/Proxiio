@model UserResponse
@{
    ViewData["Title"] = "Admin Dashboard - Proxiio";
}
<div class="max-w-2xl mx-auto p-6 space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">User Details</h1>
            <p class="text-sm text-slate-500 mt-1">Detailed information about this account.</p>
        </div>
        <a href="/admin/users/view" class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            Back to List
        </a>
    </div>

    <!-- User Details Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

        <!-- Header Banner / Avatar Section -->
        <div class="p-6 bg-slate-50 border-b border-slate-200 flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-xl uppercase">
                @(string.IsNullOrEmpty(Model.Name) ? "U" : Model.Name.Substring(0, 1))
            </div>
            <div>
                <h2 class="text-lg font-bold text-slate-900">@Model.Name</h2>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200 mt-1">
                    @Model.Role.ToString()
                </span>
            </div>
        </div>

        <!-- Form Fields Grid -->
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Name -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Full Name</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-user text-sm"></i>
                    </div>
                    <input type="text" name="Name" value="@Model.Name" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            <!-- Email -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Email Address</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-envelope text-sm"></i>
                    </div>
                    <input type="email" name="Email" value="@Model.Email" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            <!-- Password -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </div>
                    <input type="password" name="Password" value="@Model.Password" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            <!-- Role -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Role</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-user-shield text-sm"></i>
                    </div>
                    <input type="text" name="Role" value="@Model.Role.ToString()" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            
            <!-- UserState -->
            <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">User State</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-user-shield text-sm"></i>
                    </div>
                    <input type="text" name="UserState" value="@Model.UserState.ToString()" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            <!-- Date of Birth -->
            <div class="space-y-1.5 md:col-span-2">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Date of Birth</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-calendar text-sm"></i>
                    </div>
                    <input type="text" name="DateOfBirth" value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMMM yyyy") : "N/A")" readonly class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-medium text-slate-800 cursor-not-allowed focus:outline-none" />
                </div>
            </div>

            <!-- Newsletter Preference -->
            <div class="md:col-span-2 pt-2 border-t border-slate-100">
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-indigo-50 text-indigo-600 rounded-md">
                            <i class="fa-solid fa-newspaper text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-slate-800">Newsletter Subscription</p>
                            <p class="text-xs text-slate-500">User preference for promotional emails</p>
                        </div>
                    </div>
                    <div>
                        @if (Model.ReceiveNewsLetter.HasValue && Model.ReceiveNewsLetter.Value)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                Subscribed
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-200 text-slate-600">
                                <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                Not Subscribed
                            </span>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer Actions -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
            <a href="/admin/users/view" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                Close
            </a>
        </div>
    </div>
</div>