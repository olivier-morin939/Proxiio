@model IEnumerable<UserResponse>
@{
    ViewData["Title"] = "Admin - View Users";
}

@section HeadContent
{
    <link rel="stylesheet" href="~/css/Tabs.css" />
}

<div class="app-tabs-container">
    <!-- Header Page -->
    <div class="app-tabs-header">
        <div>
            <h1 class="app-tabs-title">Users</h1>
            <p class="app-tabs-subtitle">Manage and filter your system users.</p>
        </div>
        <div class="admin-header-actions">
            <!-- Bouton Ajouter un Utilisateur -->
            <a asp-controller="Admin" asp-action="AddUser" class="app-tab-btn app-tab-btn-primary">
                <i class="fa-solid fa-plus text-xs"></i>
                Add User
            </a>
            <!-- Bouton Export PDF -->
            <a asp-controller="Admin" asp-action="ExportToPDF" asp-route-ModelToExport="UserResponse" class="app-tab-btn app-tab-btn-secondary">
                <i class="fa-solid fa-file-pdf"></i>
                Export users in PDF
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    @{
        await Html.RenderPartialAsync("_FlashMessagesComponent");
    }

    <!-- Filter & Search Bar -->
    <div class="app-tabs-filter-card">
        <form asp-controller="Admin" asp-action="DisplayUsers" method="get" class="app-tabs-filter-form">

            <!-- Select Field -->
            <div class="app-tabs-select-wrapper">
                <select name="searchBy" class="app-tabs-select">
                    @if (ViewBag.SearchFields != null)
                    {
                        foreach (var field in ViewBag.SearchFields)
                        {
                            <option value="@field.Key" selected="@(ViewBag.CurrentSearchBy == field.Key ? "selected" : null)">
                                @field.Value
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- Search Input -->
            <div class="app-tabs-search-wrapper">
                <div class="app-tabs-search-icon">
                    <i class="fa-solid fa-magnifying-glass text-sm"></i>
                </div>
                <input type="search" name="searchString" placeholder="Search users..." value="@ViewBag.CurrentSearchString" class="app-tabs-search-input" />
            </div>

            <!-- Action Buttons -->
            <div class="app-tabs-actions-wrapper">
                <button type="submit" class="app-tab-btn app-tab-btn-primary" style="width: 100%;">
                    <i class="fa-solid fa-filter text-xs"></i>
                    Search
                </button>

                <a asp-controller="Admin" asp-action="DisplayUsers" class="app-tab-btn app-tab-btn-icon" title="Reset Filters">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Data Table Container / Empty State -->
    @if (Model != null && Model.Any())
    {
        <div class="app-tabs-table-card">
            <div class="app-tabs-table-responsive">
                <table class="app-tabs-table">

                    @{
                        await Html.RenderPartialAsync("_UserHeaderTab", viewData: ViewData);
                    }

                    <tbody class="app-tabs-tbody">
                        @foreach (UserResponse userResponse in Model)
                        {
                            <tr class="app-tabs-tr">
                                <!-- Utilisateur (Nom) -->
                                <td class="app-tabs-td">
                                    <span class="app-tabs-user-name">@userResponse.Name</span>
                                </td>

                                <!-- Email -->
                                <td class="app-tabs-td app-tabs-text-muted">
                                    @userResponse.Email
                                </td>

                                <!-- Rôle -->
                                <td class="app-tabs-td">
                                    <span class="app-tab-badge app-tab-badge-role">
                                        @userResponse.Role.ToString()
                                    </span>
                                </td>

                                <!-- État -->
                                <td class="app-tabs-td">
                                    @if (userResponse.UserState.ToString().ToLower() == "active")
                                    {
                                        <span class="app-tab-badge app-tab-badge-active">
                                            <span class="app-tab-badge-dot app-tab-dot-emerald"></span>
                                            @userResponse.UserState.ToString()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-tab-badge app-tab-badge-inactive">
                                            <span class="app-tab-badge-dot app-tab-dot-amber"></span>
                                            @userResponse.UserState.ToString()
                                        </span>
                                    }
                                </td>

                                <!-- Date de naissance -->
                                <td class="app-tabs-td app-tabs-text-muted">
                                    <span>@userResponse.DateOfBirth.ToString("dd MMM yyyy")</span>
                                </td>

                                <!-- Newsletter -->
                                <td class="app-tabs-td">
                                    @if (userResponse.ReceiveNewsLetter)
                                    {
                                        <span class="app-tab-badge app-tab-badge-newsletter">
                                            <span class="app-tab-badge-dot app-tab-dot-emerald"></span>
                                            Subscribed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-tab-badge app-tab-badge-no-newsletter">
                                            <span class="app-tab-badge-dot app-tab-dot-slate"></span>
                                            Not Subscribed
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="app-tabs-td" style="text-align: right;">
                                    <div class="app-tab-actions-cell">
                                        <a asp-controller="Admin" asp-action="DisplaySpecificUser" asp-route-userId="@userResponse.UserId"
                                           class="app-tab-action-btn app-tab-action-details">
                                            Details
                                        </a>
                                        <a asp-controller="Admin" asp-action="UpdateSpecificUser" asp-route-userId="@userResponse.UserId"
                                           class="app-tab-action-btn app-tab-action-update">
                                            Update
                                        </a>
                                        <a asp-controller="Admin" asp-action="DeleteSpecificUser" asp-route-userId="@userResponse.UserId"
                                           class="app-tab-action-btn app-tab-action-delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State Component -->
        <div class="app-tabs-empty-card">
            <div class="app-tabs-empty-icon-wrapper">
                <i class="fa-solid fa-users-slash text-xl"></i>
            </div>
            <h3 class="app-tabs-empty-title">No users found</h3>
            <p class="app-tabs-empty-desc">
                We couldn't find any users matching your criteria. Try adjusting your search term or filter.
            </p>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearchString))
            {
                <a href="/admin/users/view" class="app-tab-btn app-tab-btn-icon" style="display: inline-flex;">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    Clear Search
                </a>
            }
        </div>
    }
</div>