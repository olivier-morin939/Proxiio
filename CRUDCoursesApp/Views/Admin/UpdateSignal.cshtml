@model ServiceContracts.DTO.Signals.UpdateSignalRequest
@{ ViewData["Title"] = "Modifier un signal"; }
<div class="admin-form-page"><a asp-action="DisplaySignals" class="admin-back-link">← Retour aux signaux</a><form asp-action="UpdateSignal" asp-route-id="@Model.Id" method="post" class="admin-form-card"><span class="admin-kicker">SUIVI TECHNIQUE</span><h1>Modifier le signal</h1><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="admin-validation"></div><div class="admin-form-grid"><label class="admin-field full">Nom du problème<input asp-for="ProblemName" class="admin-input" maxlength="120" required /></label><label class="admin-field full">Description<textarea asp-for="ProblemDescription" class="admin-textarea" rows="4" maxlength="254"></textarea></label><label class="admin-field">Niveau<select asp-for="Level" asp-items="Html.GetEnumSelectList<BugSignalLevel>()" class="admin-select"></select></label><label class="admin-field">Statut<select asp-for="Status" asp-items="Html.GetEnumSelectList<BugSignalStatus>()" class="admin-select"></select></label><label class="admin-field full admin-checkbox"><input asp-for="IsConfirmed" /> Problème confirmé</label></div><div class="admin-form-actions"><a asp-action="DisplaySignals" class="admin-btn secondary">Annuler</a><button type="submit" class="admin-btn">Enregistrer</button></div></form></div>
