@model UserResponse
@{
    ViewData["Title"] = "Admin - Delete User";
}

@* Styling files needed for this page *@
@section HeadContent
{
    <link rel="stylesheet" href="~/css/Forms.css" />
}

<div class="app-form-container">
    <!-- Header -->
    <div class="app-form-header">
        <div>
            <h1 class="app-form-title">Delete User</h1>
            <p class="app-form-subtitle">Confirm account deletion below.</p>
        </div>
        <a asp-controller="Admin" asp-action="DisplayUsers" class="app-btn app-btn-secondary">
            <i class="fa-solid fa-arrow-left text-xs"></i> Back to List
        </a>
    </div>

    <!-- Flash Messages -->
    @{
        await Html.RenderPartialAsync("_FlashMessagesComponent");
    }


    <!-- Danger Alert Message -->
    <div class="app-alert-danger">
        <div class="app-alert-icon">
            <i class="fa-solid fa-triangle-exclamation text-lg"></i>
        </div>
        <div>
            <h3 class="app-alert-title">Warning: Permanent Action</h3>
            <p class="app-alert-text">
                Are you sure you want to delete this user? This operation cannot be undone and all associated data will be removed.
            </p>
        </div>
    </div>

    <!-- User Details Card (Readonly) -->
    <div class="app-form-card">

        <!-- Banner Avatar Section -->
        <div class="app-user-banner">
            <div class="app-avatar app-avatar-rose">
                @(string.IsNullOrEmpty(Model.Name) ? "U" : Model.Name.Substring(0, 1))
            </div>
            <div>
                <h2 style="font-size: 1.125rem; font-weight: 700; color: #0f172a; margin: 0;">@Model.Name</h2>
                <span class="app-badge app-badge-neutral" style="margin-top: 0.25rem;">
                    @Model.Role.ToString()
                </span>
            </div>
        </div>

        <!-- Form Fields Grid -->
        <div class="app-form-body">
            <div class="app-form-grid">

                <!-- Name -->
                <div class="app-form-group">
                    <label class="app-form-label">Full Name</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-user text-sm"></i></div>
                        <input asp-for="Name" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- Email -->
                <div class="app-form-group">
                    <label class="app-form-label">Email Address</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-envelope text-sm"></i></div>
                        <input asp-for="Email" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- Password -->
                <div class="app-form-group">
                    <label class="app-form-label">Password</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-lock text-sm"></i></div>
                        <input asp-for="Password" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- Role -->
                <div class="app-form-group">
                    <label class="app-form-label">Role</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-user-shield text-sm"></i></div>
                        <input asp-for="Role" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- User State -->
                <div class="app-form-group">
                    <label class="app-form-label">User State</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-user-shield text-sm"></i></div>
                        <input asp-for="UserState" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- Date of Birth -->
                <div class="app-form-group" style="grid-column: 1 / -1;">
                    <label class="app-form-label">Date of Birth</label>
                    <div class="app-form-input-wrapper">
                        <div class="app-form-icon"><i class="fa-solid fa-calendar text-sm"></i></div>
                        <input type="text" value="@(Model.DateOfBirth.ToString("dd MMMM yyyy"))" readonly class="app-form-input" style="cursor: not-allowed;" />
                    </div>
                </div>

                <!-- Newsletter Preference -->
                <div style="grid-column: 1 / -1;" class="app-form-option-card">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="padding: 0.5rem; background-color: var(--app-slate-200); color: var(--app-slate-600); border-radius: var(--app-radius-lg);">
                                <i class="fa-solid fa-newspaper text-sm"></i>
                            </div>
                            <div>
                                <p class="app-form-option-title" style="margin:0;">Newsletter Subscription</p>
                                <p class="app-form-option-desc" style="margin:0;">User preference for promotional emails</p>
                            </div>
                        </div>
                        <div>
                            @if (Model.ReceiveNewsLetter)
                            {
                                <span class="app-badge app-badge-success">
                                    <span class="app-badge-dot"></span> Subscribed
                                </span>
                            }
                            else
                            {
                                <span class="app-badge app-badge-neutral">
                                    <span class="app-badge-dot"></span> Not Subscribed
                                </span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Danger Zone Footer Actions -->
        <div class="app-form-actions" style="padding: 1rem 1.5rem; background-color: #fff1f2; border-top: 1px solid var(--app-rose-200); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.75rem; font-weight: 500; color: var(--app-rose-700);">
                Confirming will permanently delete this account.
            </span>
            <form asp-controller="Admin" asp-action="DeleteSpecificUserConfirm" asp-route-UserId="@Model.UserId" method="post" style="display: flex; align-items: center; gap: 0.75rem; margin: 0;">
                <a asp-controller="Admin" asp-action="DisplayUsers" class="app-btn app-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="app-btn app-btn-danger">
                    <i class="fa-solid fa-trash-can text-xs"></i> Confirm Delete
                </button>
            </form>
        </div>

    </div>
</div>
