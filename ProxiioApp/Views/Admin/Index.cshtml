@{
    ViewData["Title"] = "Administration";
    var cards = new[] {
        new { Title = "Utilisateurs", Description = "Comptes, rôles et accès", Count = (int)ViewBag.TotalUserCounts, Icon = "fa-users", Tone = "violet", Action = "DisplayUsers" },
        new { Title = "Communautés", Description = "Espaces et membres", Count = (int)ViewBag.TotalComunitiesCounts, Icon = "fa-people-group", Tone = "mint", Action = "DisplayComunities" },
        new { Title = "Publications", Description = "Conversations et contenu", Count = (int)ViewBag.TotalPostsCounts, Icon = "fa-file-lines", Tone = "blue", Action = "DisplayPosts" },
        new { Title = "Signaux", Description = "Bugs et problèmes techniques", Count = (int)ViewBag.TotalSignalsCounts, Icon = "fa-triangle-exclamation", Tone = "amber", Action = "DisplaySignals" },
        new { Title = "Signalements", Description = "Contenus rapportés", Count = (int)ViewBag.TotalReportsCounts, Icon = "fa-flag", Tone = "rose", Action = "DisplayReports" }
    };
}
<main class="admin-page">
    <div class="admin-content">
        <div class="admin-heading"><div><span class="admin-kicker">ESPACE DE GESTION</span><h1>Tableau de bord</h1><p>Bonjour ! Voici ce qui se passe dans ton espace communautaire.</p></div><span class="admin-status"><i></i> Système opérationnel</span></div>
        @await Html.PartialAsync("_FlashMessagesComponent")
        <section class="admin-stats-grid">
            @foreach (var card in cards)
            {
                <a class="admin-stat-card" asp-controller="Admin" asp-action="@card.Action"><span class="admin-stat-icon @card.Tone"><i class="fa-solid @card.Icon"></i></span><span class="admin-stat-copy"><small>@card.Title</small><b>@card.Count</b><em>@card.Description</em></span><span class="admin-stat-arrow">↗</span></a>
            }
            <a class="admin-stat-card report-shortcut" asp-controller="Admin" asp-action="AddReport"><span class="admin-stat-icon rose"><i class="fa-solid fa-plus"></i></span><span class="admin-stat-copy"><small>Nouveau signalement</small><b>Créer</b><em>Signaler une publication</em></span><span class="admin-stat-arrow">↗</span></a>
        </section>
        <div class="admin-lower-grid">
            <section class="admin-panel"><div class="admin-panel-heading"><div><span class="admin-kicker">ACCÈS RAPIDE</span><h2>Gérer la plateforme</h2></div><span class="admin-panel-spark">✳</span></div><div class="admin-quick-links">
                <a asp-controller="Admin" asp-action="AddUser"><span class="quick-icon violet"><i class="fa-solid fa-user-plus"></i></span><span><b>Ajouter un utilisateur</b><small>Créer un compte membre</small></span><em>→</em></a>
                <a asp-controller="Admin" asp-action="AddComunity"><span class="quick-icon mint"><i class="fa-solid fa-people-group"></i></span><span><b>Créer une communauté</b><small>Lancer un nouvel espace</small></span><em>→</em></a>
                <a asp-controller="Admin" asp-action="DisplayPosts"><span class="quick-icon blue"><i class="fa-solid fa-list"></i></span><span><b>Modérer les publications</b><small>Consulter le fil complet</small></span><em>→</em></a>
                <a asp-controller="Admin" asp-action="AddSignal"><span class="quick-icon amber"><i class="fa-solid fa-bug"></i></span><span><b>Créer un signal</b><small>Ajouter un problème technique</small></span><em>→</em></a>
                <a asp-controller="Admin" asp-action="AddReport"><span class="quick-icon rose"><i class="fa-solid fa-flag"></i></span><span><b>Créer un signalement</b><small>Rapporter une publication</small></span><em>→</em></a>
            </div></section>
            <aside class="admin-welcome-panel"><div class="admin-welcome-art"><span>✦</span><i>✳</i><b>✧</b></div><span class="admin-kicker">PROXIIO · ADMIN</span><h2>Une communauté<br/>plus saine, ensemble.</h2><p>Gère les membres, encourage les échanges et traite les signalements depuis un seul endroit.</p><a asp-controller="Admin" asp-action="DisplayReports" class="admin-primary-link">Voir les signalements <span>→</span></a></aside>
        </div>
        </div>
</main>



