<thead class="bg-slate-100 border-b border-slate-200">
    <tr>
        <!-- Name -->
        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
            @if (ViewBag.CurrentSortBy == nameof(UserResponse.Name) && ViewBag.CurrentSortOrder == SortOption.ASC.ToString())
            {
                <a asp-controller="Admin" asp-action="DisplayUsers" asp-route-searchBy="@(ViewBag.CurrentSearchBy)" asp-route-searchString="@(ViewBag.CurrentSearchString)" asp-route-sortBy="@(nameof(UserResponse.Name))" asp-route-sortOption="DESC" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-800 transition-colors duration-150">
                    User Name <i class="fa-solid fa-chevron-up text-xs"></i>
                </a>
            }
            else if (ViewBag.CurrentSortBy == nameof(UserResponse.Name) && ViewBag.CurrentSortOrder == SortOption.DESC.ToString())
            {
                <a asp-controller="Admin" asp-action="DisplayUsers" asp-route-searchBy="@(ViewBag.CurrentSearchBy)" asp-route-searchString="@(ViewBag.CurrentSearchString)" asp-route-sortBy="@(nameof(UserResponse.Name))" asp-route-sortOption="ASC" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-800 transition-colors duration-150">
                    User Name <i class="fa-solid fa-chevron-down text-xs"></i>
                </a>
            }
            else
            {
                <a asp-controller="Admin" asp-action="DisplayUsers" asp-route-searchBy="@(ViewBag.CurrentSearchBy)" asp-route-searchString="@(ViewBag.CurrentSearchString)" asp-route-sortBy="@(nameof(UserResponse.Name))" asp-route-sortOption="ASC" class="inline-flex items-center gap-1.5 hover:text-slate-900 transition-colors duration-150">
                    User Name
                </a>
            }
        </th>

