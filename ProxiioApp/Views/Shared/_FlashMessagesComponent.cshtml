@if (TempData["ErrorMessage"] != null)
{
    <div class="admin-flash error"><i class="fa-solid fa-circle-exclamation"></i><div>@TempData["ErrorMessage"]</div></div>
}
@if (TempData["DuplicateErrorMessage"] != null)
{
    <div class="admin-flash warning"><i class="fa-solid fa-triangle-exclamation"></i><div>@TempData["DuplicateErrorMessage"]</div></div>
}
@if (TempData["InvalidErrorMessage"] != null)
{
    <div class="admin-flash error"><i class="fa-solid fa-ban"></i><div>@TempData["InvalidErrorMessage"]</div></div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="admin-flash success"><i class="fa-solid fa-circle-check"></i><div>@TempData["SuccessMessage"]</div></div>
}
