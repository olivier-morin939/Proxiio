@model CRUDCoursesApp.ViewModels.CommunityHomeViewModel
@{ ViewData["Title"] = "Accueil"; }
<div class="app-shell">
     <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">p</span><span>proxiio</span></a>
        <div class="side-label">ESPACE COMMUNAUTAIRE</div>
        <a class="side-link" href="/"><span>⌂</span> Fil d'actualité</a>
        <a class="side-link" href="#communautes"><span>▦</span> Découvrir</a>
        <div class="side-label side-label-row">VOS COMMUNAUTÉS <span>@Model.Communities.Count</span></div>
        @foreach (var community in Model.Communities)
        {
            <a class="community-link" asp-controller="Communities" asp-action="Details" asp-route-id="@community.Id"><span class="community-avatar">@community.Name?.Substring(0, 1).ToUpper()</span><span>@community.Name</span></a>
        }
        <a class="side-link muted-link" href="#creer"><span>＋</span> Créer une communauté</a>
        <div class="sidebar-bottom"><span class="avatar avatar-purple">@Model.CurrentUserName.Substring(0, 1).ToUpper()</span><span><b>@Model.CurrentUserName</b><small>Espace membre</small></span><span class="more">•••</span></div>
    </aside> 

    <main class="main-area">
        <div class="content-wrap">
            <section class="welcome-banner"><div><span class="eyebrow">TON ESPACE POUR PROGRESSER</span><h1>Apprends ensemble.<br/><em>Va plus loin.</em></h1><p>Retrouve tes communautés, partage tes idées et avance avec des gens qui te ressemblent.</p><a href="#communautes" class="button button-light">Explorer les communautés <span>→</span></a></div><div class="banner-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-card card-back">✳<small>APPRENDRE</small></div><div class="art-card card-front"><span>✦</span><small>ENSEMBLE</small></div><div class="art-spark">✧</div></div></section>
            @if (TempData["Error"] is string error) { <div class="notice">@error</div> }
            <div class="section-heading"><div><span class="eyebrow dark-eyebrow">LE CAMPUS</span><h2>Ton fil d'actualité</h2><p>Les dernières nouvelles de tes communautés.</p></div><a href="#communautes" class="text-link">Explorer <span>→</span></a></div>
            <div class="dashboard-grid">
                <section class="feed-column">
                    @foreach (var item in Model.Feed)
                    {
                        <article class="post-card"><div class="post-community"><span class="community-avatar">@item.CommunityName.Substring(0, 1).ToUpper()</span><div><a asp-controller="Communities" asp-action="Details" asp-route-id="@item.CommunityId">@item.CommunityName</a><small>Publication de la communauté</small></div><button class="dots">•••</button></div><div class="post-content"><div class="author-row"><span class="avatar avatar-teal">@item.AuthorName.Substring(0, 1).ToUpper()</span><span><b>@item.AuthorName</b><small>@item.Post.CreatedAt.ToLocalTime().ToString("dd MMM 'à' HH:mm")</small></span></div><h3>@item.Post.Title</h3><p>@item.Post.Body</p><a class="post-open" asp-controller="Communities" asp-action="Details" asp-route-id="@item.CommunityId">Voir la discussion <span>→</span></a></div><div class="post-footer"><span>♡ &nbsp;Réagir</span><span>◯ &nbsp;Commenter</span><span class="share-action">↗ &nbsp;Partager</span></div></article>
                    }
                    @if (!Model.Feed.Any()) { <div class="empty-state"><span>✦</span><h3>Le fil se réveille bientôt</h3><p>Rejoins une communauté et les conversations apparaîtront ici.</p></div> }
                </section>
                <aside class="right-column">
                    <section class="side-card profile-card"><div class="profile-cover"></div><span class="avatar avatar-large avatar-purple">@Model.CurrentUserName.Substring(0, 1).ToUpper()</span><h3>@Model.CurrentUserName</h3><p>Membre de la communauté</p><div class="profile-stats"><span><b>@Model.Communities.Count</b><small>communautés</small></span><span><b>@Model.Feed.Count</b><small>publications</small></span></div></section>
                    <section class="side-card discover-card" id="communautes"><div class="card-heading"><div><span class="eyebrow dark-eyebrow">FAIS PARTIE DU MOUVEMENT</span><h3>À découvrir</h3></div><span class="sparkle">✳</span></div>
                        @foreach (var community in Model.Communities.Take(4)) { <a class="discover-item" asp-controller="Communities" asp-action="Details" asp-route-id="@community.Id"><span class="community-avatar">@community.Name?.Substring(0, 1).ToUpper()</span><span class="discover-copy"><b>@community.Name</b><small>@community.Description</small></span><span class="arrow">↗</span></a> }
                        @if (!Model.Communities.Any()) { <p class="empty-copy">Aucune communauté trouvée. Crée la première !</p> }
                    </section>
                    <section class="side-card create-card" id="creer"><span class="create-icon">＋</span><h3>Une idée de communauté ?</h3><p>Rassemble des personnes autour de ce qui te passionne.</p><details><summary class="button button-dark">Créer une communauté</summary><form asp-controller="Communities" asp-action="Create" method="post" class="mini-form"><label>Nom<input name="name" maxlength="120" required placeholder="Ex. Les makers" /></label><label>Description<textarea name="description" maxlength="254" rows="3" placeholder="De quoi parle ta communauté ?"></textarea></label><button class="button button-purple" type="submit">Créer mon espace</button></form></details></section>
                </aside>
            </div>
        </div>
    </main>
</div>

